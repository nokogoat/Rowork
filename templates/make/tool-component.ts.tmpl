import { BaseComponent, Component } from "@flamework/components";
import { OnStart } from "@flamework/core";
import { {{ constName }} } from "{{ configImport }}";

const Players = game.GetService("Players");

/**
 * Server-side behaviour of the {{ base }} tool. Flamework attaches it to every
 * Tool carrying the "{{ tag }}" tag, which `ToolService.give` sets for you.
 */
@Component({ tag: {{ constName }}.tag })
export class {{ className }} extends BaseComponent<{}, Tool> implements OnStart {
	private lastActivation = 0;

	onStart(): void {
		this.instance.Activated.Connect(() => {
			const player = Players.GetPlayerFromCharacter(this.instance.Parent);
			if (player === undefined) return;

			const now = os.clock();
			if (now - this.lastActivation < {{ constName }}.cooldown) return;
			this.lastActivation = now;

			this.activate(player);
		});
	}

	/** Called on the server each time the player uses the tool, cooldown respected. */
	private activate(player: Player): void {
		print(`[${player.Name}] used {{ base }}`);
	}
}
