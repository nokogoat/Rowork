import { OnStart, Service } from "@flamework/core";
import type { ToolDefinition } from "{{ definitionImport }}";
import { TOOLS } from "{{ registryImport }}";

const Players = game.GetService("Players");
const CollectionService = game.GetService("CollectionService");

/**
 * Creates and hands out tools. Created once by `rowork make:tool`.
 *
 * Every tool whose settings say `giveOnSpawn: true` reaches each player when
 * they spawn, so there is nothing to write for the usual case. To give a tool
 * at another moment (a shop, a reward), inject this service and call
 * `give(player, PickaxeTool)`.
 */
@Service()
export class ToolService implements OnStart {
	onStart(): void {
		for (const player of Players.GetPlayers()) this.watch(player);
		Players.PlayerAdded.Connect((player) => this.watch(player));
	}

	/** Puts the tool in the player's backpack and returns it. */
	give(player: Player, definition: ToolDefinition): Tool {
		const backpack = player.FindFirstChildOfClass("Backpack");
		if (backpack === undefined) error(`${player.Name} has no Backpack yet`);

		const tool = new Instance("Tool");
		tool.Name = definition.name;
		tool.CanBeDropped = definition.canBeDropped;

		// A tool needs a Handle to be equippable. Replace this placeholder with
		// your own model when you have one.
		const handle = new Instance("Part");
		handle.Name = "Handle";
		handle.Size = new Vector3(1, 1, 1);
		handle.Parent = tool;

		CollectionService.AddTag(tool, definition.tag);
		tool.Parent = backpack;
		return tool;
	}

	private watch(player: Player): void {
		const giveSpawnTools = (): void => {
			for (const definition of TOOLS) {
				if (definition.giveOnSpawn) this.give(player, definition);
			}
		};

		if (player.Character !== undefined) giveSpawnTools();
		player.CharacterAdded.Connect(giveSpawnTools);
	}
}
