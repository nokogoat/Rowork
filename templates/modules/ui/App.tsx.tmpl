import React, { useState } from "@rbxts/react";
import { Button } from "./Button";

/**
 * The root of your interface: everything on screen starts here.
 *
 * A component is a function that returns what to draw. `useState` keeps a value
 * that redraws the interface when it changes. The lowercase tags (frame,
 * textbutton, ...) are Roblox instances; your own components start with a capital.
 */
export function App() {
	const [count, setCount] = useState(0);

	return (
		<frame Size={UDim2.fromScale(1, 1)} BackgroundTransparency={1}>
			<Button text={`Clicked ${count} times`} onClick={() => setCount(count + 1)} />
		</frame>
	);
}
